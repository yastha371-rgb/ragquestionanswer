# ==============================================================================
# Academic Q&A RAG System Configuration (100% Free with Google Gemini)
# ==============================================================================

# API Configuration
DEBUG=false

# Google Gemini Free API Key (Get free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Vector Database (ChromaDB) Configuration
CHROMA_PATH=./data/chroma_db
VECTOR_STORE_NAME=academic_qa

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# Document Management Configuration
DOCUMENT_STORAGE_PATH=./data/documents
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,txt,docx,csv,xlsx,xls

# RAG Retrieval & Generation Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
MIN_CONFIDENCE_SCORE=0.5
